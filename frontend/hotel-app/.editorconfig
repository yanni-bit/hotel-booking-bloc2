# ============================================
# FICHIER : .editorconfig
# DESCRIPTION : Configuration de l'éditeur de code pour le projet.
#               Assure la cohérence du formatage entre les développeurs
#               (indentation, encodage, quotes, fin de ligne).
# AUTEUR : Yannick
# DATE : 2025
# RÈGLES :
#   - Encodage UTF-8 pour tous les fichiers
#   - Indentation : 2 espaces (convention Angular)
#   - Simple quotes pour les fichiers TypeScript
#   - Pas de trim sur les fichiers Markdown
# ============================================

# Editor configuration, see https://editorconfig.org
root = true

# --- Règles globales pour tous les fichiers ---
[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# --- Règles spécifiques TypeScript : simple quotes ---
[*.ts]
quote_type = single
ij_typescript_use_double_quotes = false

# --- Règles spécifiques Markdown : pas de trim, pas de limite de ligne ---
[*.md]
max_line_length = off
trim_trailing_whitespace = false